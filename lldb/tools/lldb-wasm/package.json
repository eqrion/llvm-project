{
  "name": "lldb-wasm",
  "version": "0.1.6",
  "description": "LLDB compiled to WebAssembly for debugging wasm modules in browsers and Node.js",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "wasm/"
  ],
  "scripts": {
    "copy-wasm": "node scripts/copy-wasm.mjs",
    "build": "npm run copy-wasm && tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eqrion/llvm-project.git",
    "directory": "lldb/tools/lldb-wasm"
  },
  "keywords": [
    "lldb",
    "webassembly",
    "wasm",
    "debugger",
    "devtools"
  ],
  "license": "Apache-2.0"
}
